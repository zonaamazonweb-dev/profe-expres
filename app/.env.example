# IA (SIEMPRE en env var, nunca hardcodeado)
AI_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=                 # SOLO servidor — jamás con prefijo NEXT_PUBLIC_
# Precio del modelo en USD por millón de tokens (para calcular el costo real de cada llamada).
# Verifica el precio vigente de tu modelo en el panel de Anthropic.
AI_PRICE_INPUT_PER_MTOK=3
AI_PRICE_OUTPUT_PER_MTOK=15

# Supabase (nomenclatura nueva)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx   # pública por diseño (RLS la protege)
SUPABASE_SECRET_KEY=sb_secret_xxxx                         # SOLO servidor — salta RLS
